{
  "name": "apporbit",
  "productName": "AppOrbit",
  "version": "1.0.0",
  "description": "AppOrbit 2.0 — Every app. One orbit. Massive Cross-Platform Software Installer",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/index.test.js",
    "build:catalog": "node scripts/build-catalog.js",
    "build": "node scripts/build-catalog.js && electron-builder --win nsis portable --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "postbuild": "node scripts/postbuild.js"
  },
  "build": {
    "appId": "com.apporbit.desktop",
    "productName": "AppOrbit",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "AppOrbit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AppOrbit"
    },
    "portable": {
      "artifactName": "AppOrbit-Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    }
  },
  "keywords": [
    "apporbit",
    "installer",
    "ninite-alternative",
    "package-manager",
    "winget",
    "homebrew",
    "flatpak",
    "cross-platform"
  ],
  "author": "AppOrbit Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.2.8",
    "electron-builder": "^25.1.8"
  }
}
